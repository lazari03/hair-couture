DATABASE_URL="file:./dev.db"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
# Generate: node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
# Base64-encoded — the raw hash's $-sequences get corrupted by Next.js's
# env-var interpolation otherwise.
ADMIN_PASSWORD_HASH_B64=""

# Brevo (Sendinblue) — order confirmation emails, contact-form
# notifications, and newsletter signups. Empty until a real key is
# supplied; lib/email.ts no-ops (logs, doesn't throw) while unset.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
BREVO_NEWSLETTER_LIST_ID=""

# Google Analytics 4 — public, reaches the client bundle (GA's gtag.js
# needs it client-side, unlike the server-only vars above). Empty until a
# real Measurement ID is supplied; no GA script loads while unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
