# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
src/generated

# Prisma SQLite — DATABASE_URL="file:./dev.db" resolves relative to cwd
# (project root when run via npm scripts), not relative to prisma/, so the
# real file lives at the repo root. Regenerate anytime with
# `npx prisma migrate dev && npm run db:seed` — never commit this, a binary
# SQLite file can't be 3-way merged and doing so caused a real conflict.
/dev.db
/dev.db-journal
prisma/*.db
prisma/*.db-journal
