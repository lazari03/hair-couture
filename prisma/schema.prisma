// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Category is a free-text field, not an enum/table — typing a new value in
// the admin form makes it filterable immediately (skills/i18n.md-style
// "customizable, not hardcoded" applies here too). Brand identity/theme
// still lives in lib/brands.ts; this only owns product data.
model Product {
  id        String   @id @default(cuid())
  brand     String
  name      String
  category  String
  price     Float
  badge     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
}
