// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Category is a free-text field, not an enum/table — typing a new value in
// the admin form makes it filterable immediately (skills/i18n.md-style
// "customizable, not hardcoded" applies here too). Brand identity/theme
// still lives in lib/brands.ts; this only owns product data.
model Product {
  id          String   @id @default(cuid())
  brand       String
  name        String
  category    String
  price       Float
  badge       String?
  description String? // plain text; real per-product copy where we have it
  imageUrl    String? // /assets/products/<brand>/<slug>.* — falls back to
  // the per-category placeholder (lib/data/category-image.ts) when unset
  stock       Int      @default(0) // decremented on order creation, admin-editable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brand])
}

// A cart is client-only state (lib/cart/cart-context.tsx) — an Order is the
// one point where it becomes a real, admin-visible record. Line items are
// snapshotted (name/variant/price) at order time, same reasoning as the
// cart itself: survives a product being renamed/repriced/deleted later.
model Order {
  id         String      @id @default(cuid())
  brand      String
  firstName  String
  lastName   String
  email      String
  phone      String
  address    String
  city       String
  postalCode String
  country    String
  couponCode String?
  subtotal   Float
  discount   Float       @default(0)
  total      Float
  status     String      @default("pending") // "pending" | "in_progress" | "fulfilled"
  items      OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([brand])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  variant   String
  price     Float
  qty       Int

  @@index([orderId])
}

// A soft stock hold, created when something is added to a cart and released
// on checkout or expiry — stops two shoppers from both "successfully" adding
// the last unit of something to their cart. SQLite has no per-row lock like
// Postgres's SELECT ... FOR UPDATE; correctness instead comes from wrapping
// the check-then-write in a Prisma interactive transaction
// (lib/actions/stock.ts), which SQLite serializes at the database level —
// coarser than a row lock, but sufficient at this scale.
// 15-minute hold: long enough to fill in a real checkout form, short enough
// not to tie up inventory from an abandoned tab — the industry-common range.
model StockReservation {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  qty       Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([cartId])
}

// Free-standing codes, not tied to a brand — admin can add more via Prisma
// Studio (`npm run db:studio`) until there's a dedicated admin CRUD for
// these, same as products.
model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String // "percent" | "fixed"
  value     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// A contact-form submission, persisted independently of email delivery so
// nothing is lost if BREVO_API_KEY is unset (lib/email.ts no-ops then) —
// same reasoning as Order being the durable record behind a transient cart.
model ContactMessage {
  id        String   @id @default(cuid())
  brand     String
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([brand])
}
