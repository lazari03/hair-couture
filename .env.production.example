# Copy to .env.production on the server and fill in real values — that
# file is what `docker compose` loads (env_file: .env.production) and is
# gitignored, same as .env* generally.

# /data is the named volume mounted into the app container (see
# docker-compose.yml) — this is what makes the SQLite DB survive
# `docker compose up --build` redeploys.
DATABASE_URL="file:/data/dev.db"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
# Generate: node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH_B64=""

# Brevo (Sendinblue) — order confirmation emails, contact-form
# notifications, and newsletter signups. Empty until a real key is
# supplied; lib/email.ts no-ops (logs, doesn't throw) while unset.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
# Optional: comma-separated recipient list for order alerts. Falls back to
# ADMIN_EMAIL when empty.
BREVO_ORDER_ALERT_TO=""
# Default newsletter list (used when brand-specific list IDs are unset).
BREVO_NEWSLETTER_LIST_ID=""
# Optional brand-specific newsletter lists.
BREVO_NEWSLETTER_LIST_ID_BALMAIN=""
BREVO_NEWSLETTER_LIST_ID_ELOURE=""
BREVO_NEWSLETTER_LIST_ID_EAU_DE_1974=""

# Google Analytics 4 — public. Empty until a real Measurement ID is
# supplied; no GA script loads while unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
